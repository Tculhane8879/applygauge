# Public browser configuration. NEXT_PUBLIC_ values are included in the client bundle.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Public local Supabase gateway used by the implemented Milestone 1 authentication UI.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55021
# Obtain this public local key with `npx --no-install supabase status --workdir .`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key
