# Private backend configuration. Copy this file to apps/api/.env.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://applygauge:applygauge_local@localhost:5432/applygauge
CORS_ORIGINS=["http://localhost:3000"]
# Public Supabase gateway metadata used to discover JWKS and validate token identity.
# No signing key or Supabase service credential belongs in the API environment.
SUPABASE_URL=http://127.0.0.1:55021
SUPABASE_JWT_AUDIENCE=authenticated
